{
  "id": "/",
  "name": "Студия",
  "short_name": "Студия",
  "description": "Проекты, фото, видео, озвучка, расшифровка, сканы, перевод, Open WebUI и агенты",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "lang": "ru",
  "background_color": "#7f786c",
  "theme_color": "#7f786c",
  "icons": [
    {"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "files", "accept": ["audio/*", "video/*", "image/*", "application/pdf", ".pdf", "text/*",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx"]}]
    }
  },
  "shortcuts": [
    {"name": "Новый чат", "url": "/#/chat", "icons": [{"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Поиск", "url": "/#/search", "icons": [{"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Агенты", "url": "/#/code", "icons": [{"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ]
}
