[Unit]
Description=studio-web — студия https://studio.example.com (учётки, чат, фото, видео)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=studio
# Group=www-data + UMask=0007: каталог сокета открыт Apache и больше никому (как у teacher-web).
# Свой порт TCP служба не слушает: адрес клиента она берёт из X-Forwarded-For и верит ему потому,
# что путь к ней один — Apache этого хоста.
Group=www-data
UMask=0007
RuntimeDirectory=studio
RuntimeDirectoryMode=0750
# Секрет (0600 root, из vault): STUDIO_DATA_KEY — ключ Fernet, им зашифрованы токены подключений
# в базе. Файл читает systemd при старте, а не служба: самой учётке studio он недоступен.
EnvironmentFile=/etc/studio/studio.env
# База — SQLite на локальном диске (на CIFS SQLite портится): /var/lib/studio, 0700.
StateDirectory=studio
StateDirectoryMode=0700
Environment=STUDIO_DB=/var/lib/studio/studio.db
# Файлы истории — шара storage \\storage\dd$\SharedData\studio (//10.77.1.5/dd$ смонтирован в
# /mnt/storage, /etc/fstab). На локальный диск запись не ложится из-за ProtectSystem=strict: без
# шары каталога SharedData/studio на диске debian нет, а завести его в /mnt, открытом только для
# чтения, служба не может — запись падает ошибкой «не удалось сохранить». «-» лишь даёт службе
# стартовать без этого каталога. Локальный каталог с тем же путём это обошёл бы — поэтому
# install.sh проверяет, что путь лежит на cifs, и пробует запись от studio.
Environment=STUDIO_MEDIA_DIR=/mnt/storage/SharedData/studio
ReadWritePaths=-/mnt/storage/SharedData/studio
# Origin для проверки изменяющих запросов
Environment=STUDIO_ORIGIN=https://studio.example.com
WorkingDirectory=/opt/services/studio
# --no-proxy-headers: адрес клиента студия читает из X-Forwarded-For сама (auth.client_ip),
# подмена request.client и схемы uvicorn-ом ей не нужна.
# --timeout-graceful-shutdown: открытый поток чата (SSE) держит соединение минутами — uvicorn ждёт
# его не дольше 10 с, затем снимает задачи и закрывает базу (chat.stop_all, images.stop); после
# старта недописанное помечают chat.recover() и images.recover(). Предел меньше TimeoutStopSec,
# иначе каждая выкладка кончалась бы SIGKILL.
ExecStart=/opt/services/studio/.venv/bin/uvicorn main:app --app-dir /opt/services/studio/app --uds /run/studio/web.sock --no-access-log --no-proxy-headers --timeout-graceful-shutdown 10
TimeoutStopSec=30
# Ролик отдаётся с шары кусками (Range), загрузки — до 21 МиБ
MemoryMax=2G
# Ключ данных и токены подключений бывают в памяти — дамп памяти не должен лечь на диск
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
